# SurfaceWatch Environment Configuration

# Server
PORT=8080
LOG_LEVEL=info
SURFACEWATCH_DEV_ADMIN_KEY=sw_dev_admin_secret_token_123

# Database & Cache
DATABASE_URL=postgres://surfacewatch:surfacewatch_secret@localhost:5432/surfacewatch?sslmode=disable
REDIS_ADDR=localhost:6379

# Safety Flags
# Non-negotiable safety: keep false in testing and local dev.
# Set true only when explicit authorized operator scan against live targets is permitted.
SURFACEWATCH_ALLOW_LIVE_CALLS=false

# Profiling & Diagnostics
SURFACEWATCH_ENABLE_PPROF=false
